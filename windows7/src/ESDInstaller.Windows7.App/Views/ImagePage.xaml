<Page x:Class="ESDInstaller.Windows7.Views.ImagePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ESDInstaller.Windows7.Markup"
 xmlns:controls="clr-namespace:ESDInstaller.Windows7.Controls" Background="{StaticResource PageBackgroundBrush}"
 AllowDrop="True" PreviewDragEnter="ImagePage_PreviewDrag" PreviewDragOver="ImagePage_PreviewDrag"
 PreviewDrop="ImagePage_PreviewDrop">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="42,28,42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc ImagePageTitle.Text}" Style="{StaticResource PageTitle}"/>
    <TextBlock Grid.Row="1" Text="{loc:Loc ImagePageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
    <Border Grid.Row="2" x:Name="DropArea" BorderBrush="#FFB9B9B9" BorderThickness="1" Background="White" Height="170">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="{loc:StockIcon File, Large=True}" Width="42" Height="42" Margin="0,0,0,10"/>
        <Button Content="{loc:Loc SelectImageButton.Content}" Style="{StaticResource PrimaryButton}" Click="Select_Click"/>
        <TextBlock Text="{loc:Loc ImageDropHint.Text}" Foreground="#FF666666" Margin="0,11,0,0"/>
        <ProgressBar x:Name="ExtractionProgress" Width="260" Height="12" Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" x:Name="Details" Visibility="Collapsed" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{loc:Loc ImageFilenameLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Filename" Grid.Column="1"/>
      <TextBlock Grid.Row="1" Text="{loc:Loc ImageWindowsVersionLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Version" Grid.Row="1" Grid.Column="1"/>
      <TextBlock Grid.Row="2" Text="{loc:Loc ImageArchitectureLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Architecture" Grid.Row="2" Grid.Column="1"/>
      <TextBlock Grid.Row="3" Text="{loc:Loc ImageTypeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Type" Grid.Row="3" Grid.Column="1"/>
      <TextBlock Grid.Row="4" Text="{loc:Loc ImageFileSizeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Size" Grid.Row="4" Grid.Column="1"/>
      <TextBlock Grid.Row="5" Text="{loc:Loc ImageEditionCountLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="EditionCount" Grid.Row="5" Grid.Column="1"/>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,18,0,0">
      <controls:InfoBanner x:Name="Banner" Visibility="Collapsed" Margin="0,0,0,14"/>
      <Button x:Name="Next" Content="{loc:Loc NextButton.Content}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="Next_Click"/>
    </StackPanel>
  </Grid></ScrollViewer>
</Page>
